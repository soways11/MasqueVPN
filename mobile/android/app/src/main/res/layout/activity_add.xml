<?xml version="1.0" encoding="utf-8"?>
<!--
    Добавление и правка сервера — как paintAdd в окне: назад и заголовок,
    четыре поля с метками разделов, «Вставить из буфера», главная кнопка,
    при правке — «Удалить профиль», пояснение внизу.

    Порядок кнопок тот же, что в окне. На телефоне главный путь — вставить
    ссылку: ключ в 44 знака набирать пальцем никто не станет, поэтому
    «Вставить из буфера» стоит прямо над главной кнопкой.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_x"
        android:paddingEnd="@dimen/pad_x"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                style="@style/Masque.IconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_left" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/add_server"
                android:textAppearance="@style/TextAppearance.Masque.Title" />
        </LinearLayout>

        <!-- Адрес сервера -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/field_server" />
        </LinearLayout>

        <EditText
            android:id="@+id/server"
            style="@style/Masque.Field"
            android:hint="@string/hint_server"
            android:imeOptions="actionNext"
            android:inputType="textUri" />

        <!-- Ключ доступа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/field_key" />
        </LinearLayout>

        <!--
            textVisiblePassword: ключ виден (его сверяют глазами с выданным),
            но клавиатура не запоминает его в словарь подсказок — иначе ключ
            доступа всплывал бы в подсказках в любом другом приложении.
        -->
        <EditText
            android:id="@+id/key"
            style="@style/Masque.Field"
            android:fontFamily="monospace"
            android:hint="@string/hint_key"
            android:imeOptions="actionNext"
            android:inputType="textVisiblePassword|textNoSuggestions" />

        <!-- Идентификатор клиента -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/field_client_id" />
        </LinearLayout>

        <EditText
            android:id="@+id/client_id"
            style="@style/Masque.Field"
            android:fontFamily="monospace"
            android:hint="@string/hint_client_id"
            android:imeOptions="actionNext"
            android:inputType="textVisiblePassword|textNoSuggestions" />

        <!-- Имя профиля -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/field_name" />
        </LinearLayout>

        <EditText
            android:id="@+id/name"
            style="@style/Masque.Field"
            android:hint="@string/hint_name"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences" />

        <Button
            android:id="@+id/paste"
            style="@style/Masque.SecondaryButton"
            android:layout_marginTop="24dp"
            android:text="@string/paste" />

        <FrameLayout
            android:id="@+id/confirm"
            style="@style/Masque.PrimaryButton"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/confirm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/add"
                android:textAppearance="@style/TextAppearance.Masque.Button" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right" />
        </FrameLayout>

        <Button
            android:id="@+id/delete"
            style="@style/Masque.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_danger"
            android:text="@string/delete_profile"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_notice"
            android:textAppearance="@style/TextAppearance.Masque.Small" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/footer"
            android:textAppearance="@style/TextAppearance.Masque.Footer" />
    </LinearLayout>
</ScrollView>
