<?xml version="1.0" encoding="utf-8"?>
<!--
    Строка профиля: имя (зелёное у выбранного), сервер под ним, кнопка пинга
    и меню «⋯». Как paintProfileList в окне.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Masque.Row"
    android:layout_marginBottom="@dimen/row_gap"
    android:paddingEnd="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Masque.Row"
            tools:text="nederlands" />

        <TextView
            android:id="@+id/server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Masque.Small"
            tools:text="nl.example.net" />
    </LinearLayout>

    <!--
        Пинг — там, где раньше была точка выбранного: выбранный и так виден
        по зелёному имени. Высота нажатия 44dp (пальцу меньше мало), а
        видимая «таблетка» — 24dp, как PingPillH в окне: фон вписан с
        отступами 10dp (bg_ping*).
    -->
    <TextView
        android:id="@+id/ping"
        android:layout_width="@dimen/ping_w"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_ping"
        android:contentDescription="@string/ping_one"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/ping_idle"
        android:textAppearance="@style/TextAppearance.Masque.Small" />

    <ImageButton
        android:id="@+id/menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/profile_menu"
        android:scaleType="center"
        android:src="@drawable/ic_more" />
</LinearLayout>
