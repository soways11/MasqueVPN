<?xml version="1.0" encoding="utf-8"?>
<!--
    Главный экран. Порядок блоков — как в окнах Windows и Linux (MainLayout в
    internal/gui): состояние, кнопка, скорости, счётчики, профили, журнал.
    Кнопка вторая сверху не ради красоты: ради неё экран и открывают.

    Отличие от окна одно: профили показаны все. Окно не растёт выше экрана и
    потому прячет лишние в настройки, а телефон прокручивается.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_x"
        android:paddingEnd="@dimen/pad_x"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- Логотип и кнопки «добавить» и «настройки». -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Черепаха — тот же знак, что на значке приложения и в шапке
                 окна на компьютере. Украшение: читалкам экрана незачем. -->
            <ImageView
                android:layout_width="@dimen/logo_mark"
                android:layout_height="@dimen/logo_mark"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wordmark"
                android:textAppearance="@style/TextAppearance.Masque.Logo" />

            <ImageButton
                android:id="@+id/add"
                style="@style/Masque.IconButton"
                android:contentDescription="@string/add_server"
                android:src="@drawable/ic_plus" />

            <ImageButton
                android:id="@+id/settings"
                style="@style/Masque.IconButton"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_sliders" />
        </LinearLayout>

        <!-- Состояние строкой: точка, надпись, время сессии справа. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_dot"
                android:layout_width="@dimen/dot"
                android:layout_height="@dimen/dot"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/state_off"
                android:textAppearance="@style/TextAppearance.Masque.Label" />

            <TextView
                android:id="@+id/session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Masque.Label"
                tools:text="04:12" />
        </LinearLayout>

        <!-- Главная кнопка: надпись по центру, стрелка у правого края. -->
        <FrameLayout
            android:id="@+id/connect"
            style="@style/Masque.PrimaryButton"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/connect">

            <TextView
                android:id="@+id/connect_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/connect"
                android:textAppearance="@style/TextAppearance.Masque.Button" />

            <ImageView
                android:id="@+id/connect_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right" />
        </FrameLayout>

        <!-- Скорости. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/tile_h"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rate_down"
                    android:textAppearance="@style/TextAppearance.Masque.Label" />

                <TextView
                    android:id="@+id/rate_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/zero_rate"
                    android:textAppearance="@style/TextAppearance.Masque.Value" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tile_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:minHeight="@dimen/tile_h"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rate_up"
                    android:textAppearance="@style/TextAppearance.Masque.Label" />

                <TextView
                    android:id="@+id/rate_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/zero_rate"
                    android:textAppearance="@style/TextAppearance.Masque.Value" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Причина неудачи — на месте счётчиков, как в окне: они в этот
            момент пусты, а отправлять за объяснением в журнал — лишний шаг.
        -->
        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Masque.Small"
            android:textColor="@color/danger"
            android:visibility="gone"
            tools:text="ошибка: подключение: время вышло" />

        <!-- Счётчики: три ячейки с разделителями. -->
        <LinearLayout
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stats"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/bytes_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/zero_bytes"
                    android:textAppearance="@style/TextAppearance.Masque.Number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/received"
                    android:textAppearance="@style/TextAppearance.Masque.Label" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="-2dp"
                android:background="@color/border_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/bytes_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/zero_bytes"
                    android:textAppearance="@style/TextAppearance.Masque.Number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sent"
                    android:textAppearance="@style/TextAppearance.Masque.Label" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="-2dp"
                android:layout_marginBottom="-2dp"
                android:background="@color/border_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/session_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/zero_time"
                    android:textAppearance="@style/TextAppearance.Masque.Number" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/session"
                    android:textAppearance="@style/TextAppearance.Masque.Label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Профили. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/profiles" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- Пусто: подсказка, откуда берётся доступ. -->
        <LinearLayout
            android:id="@+id/empty"
            style="@style/Masque.Row"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_server_plus"
                android:textAppearance="@style/TextAppearance.Masque.Row"
                android:textColor="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/add_server_hint"
                android:textAppearance="@style/TextAppearance.Masque.Small" />
        </LinearLayout>

        <!-- Журнал: строка-заголовок, по нажатию раскрывается хвост. -->
        <LinearLayout
            android:id="@+id/log_row"
            style="@style/Masque.Row"
            android:layout_marginTop="@dimen/row_gap">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log"
                    android:textAppearance="@style/TextAppearance.Masque.Row" />

                <TextView
                    android:id="@+id/log_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/log_empty"
                    android:textAppearance="@style/TextAppearance.Masque.Small" />
            </LinearLayout>

            <ImageView
                android:id="@+id/log_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/row_gap"
            android:background="@drawable/bg_log"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.Masque.Mono"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <!-- Распорка: подпись прижата к низу, если экран длиннее содержимого. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/footer"
            android:textAppearance="@style/TextAppearance.Masque.Footer" />
    </LinearLayout>
</ScrollView>
