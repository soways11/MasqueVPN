<?xml version="1.0" encoding="utf-8"?>
<!--
    Настройки. Короче, чем в окне, и это не упущение:

    - «Аварийное отключение» на Android делает система — «Постоянный VPN» и
      «Блокировать соединения без VPN» в её настройках. Приложение включить
      их не вправе, поэтому строка ведёт туда, а не притворяется
      переключателем, который ничего не гарантирует.
    - «Исключения» (адреса мимо блокировки) — там же: системная блокировка
      исключений не знает.
    - «Запускать при входе» — это тот же «Постоянный VPN»: система сама
      поднимает туннель после перезагрузки.
    - Профили — на главном экране целиком, отдельный список не нужен.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/pad_x"
        android:paddingEnd="@dimen/pad_x"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/back"
                style="@style/Masque.IconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_left" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textAppearance="@style/TextAppearance.Masque.Title" />
        </LinearLayout>

        <!-- Защита -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/section_protection" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/always_on"
            style="@style/Masque.Row"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kill_switch"
                    android:textAppearance="@style/TextAppearance.Masque.Row" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/kill_switch_hint"
                    android:textAppearance="@style/TextAppearance.Masque.Small" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/open"
                android:textAppearance="@style/TextAppearance.Masque.Small"
                android:textColor="@color/accent" />
        </LinearLayout>

        <!-- Серверы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/profiles" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/add"
            style="@style/Masque.Row"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_server_plus"
                android:textAppearance="@style/TextAppearance.Masque.Row"
                android:textColor="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/add_server_hint"
                android:textAppearance="@style/TextAppearance.Masque.Small" />
        </LinearLayout>

        <!-- Об устройстве -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/section_line"
                android:layout_height="1dp"
                android:background="@drawable/line_accent" />

            <TextView
                style="@style/Masque.SectionLabel"
                android:text="@string/section_about" />
        </LinearLayout>

        <!--
            Псевдоним устройства виден потому, что по одному ключу работают
            несколько устройств: в журнале сервера они различаются именно им.
        -->
        <LinearLayout
            style="@style/Masque.Row"
            android:layout_marginTop="12dp"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_id"
                android:textAppearance="@style/TextAppearance.Masque.Row" />

            <TextView
                android:id="@+id/device_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Masque.Small"
                android:textIsSelectable="true"
                tools:text="7f3a09c1e4b25d68" />
        </LinearLayout>

        <LinearLayout
            style="@style/Masque.Row"
            android:layout_marginTop="@dimen/row_gap"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version"
                android:textAppearance="@style/TextAppearance.Masque.Row" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Masque.Small"
                tools:text="0.2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/footer"
            android:textAppearance="@style/TextAppearance.Masque.Footer" />
    </LinearLayout>
</ScrollView>
