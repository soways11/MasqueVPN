<?xml version="1.0" encoding="utf-8"?>
<!-- Поле ввода. В фокусе рамка зеленеет — видно, куда пойдёт текст. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile" />
            <stroke android:width="1dp" android:color="@color/accent_dim" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile" />
            <stroke android:width="1dp" android:color="@color/border_dim" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>
