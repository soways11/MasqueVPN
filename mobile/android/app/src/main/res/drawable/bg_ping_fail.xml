<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка пинга: сервер не ответил. Видимая часть — 24dp (PingPillH) посередине 44dp нажатия. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="10dp" android:insetBottom="10dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/surface2" />
                <stroke android:width="1dp" android:color="@color/danger_line" />
                <corners android:radius="100dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="10dp" android:insetBottom="10dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="1dp" android:color="@color/danger_line" />
                <corners android:radius="100dp" />
            </shape>
        </inset>
    </item>
</selector>
